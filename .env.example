# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database the site stores its content in (optional - defaults to nluo_mediation_blogs)
MONGODB_DB=nluo_mediation_blogs

# ---------------------------------------------------------------------------
# Administrator sign-in
# ---------------------------------------------------------------------------
# Used only to sign in to this website. Keep it UNRELATED to your database
# password - anyone with this can edit every page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# If left blank the password is used instead, which means changing the
# password signs everyone out.
ADMIN_SESSION_SECRET=
